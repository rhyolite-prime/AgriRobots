{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrirobots.local/schema/agri.module.v1.schema.json",
  "title": "AMARS cassette/carrier module manifest v1",
  "description": "Signed engineering assertion for a physical cassette. Issued only after inspection, mass/CG measurement, electrical test, firmware review and configuration approval. A valid manifest is not by itself permission to energise a tool.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "module_id",
    "type",
    "firmware",
    "mass_kg",
    "cg_mm",
    "power",
    "capabilities",
    "limits",
    "calibration_bundle",
    "signature"
  ],
  "properties": {
    "schema": { "const": "agri.module/v1" },
    "module_id": { "type": "string", "pattern": "^(EG|FD|CS|WD)-01-[0-9]{4}$" },
    "type": {
      "type": "string",
      "enum": ["egg_collection", "feed", "cleaning_sanitation", "weeding"]
    },
    "firmware": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "mass_kg": { "type": "number", "exclusiveMinimum": 0 },
    "cg_mm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nominal_v", "continuous_a", "peak_a"],
      "properties": {
        "nominal_v": { "type": "number", "exclusiveMinimum": 0 },
        "continuous_a": { "type": "number", "exclusiveMinimum": 0 },
        "peak_a": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.v[0-9]+$" }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_travel_mps",
        "max_grade_pct",
        "tool_zone_class",
        "requires_operator_present"
      ],
      "properties": {
        "max_travel_mps": { "type": "number", "exclusiveMinimum": 0 },
        "max_grade_pct": { "type": "number" },
        "tool_zone_class": {
          "type": "string",
          "enum": ["benign_indoor", "service_bay", "livestock_zone", "guarded_field", "open_field"]
        },
        "requires_operator_present": { "type": "boolean" }
      }
    },
    "calibration_bundle": { "type": "string", "pattern": "^sha256:[A-Za-z0-9+/=_-]{8,}$" },
    "signature": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9+/=_-]{8,}$" }
  }
}
