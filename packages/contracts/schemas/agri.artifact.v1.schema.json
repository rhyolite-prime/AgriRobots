{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrirobots.local/schema/agri.artifact.v1.schema.json",
  "title": "AMARS signed artifact envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "createdAt",
    "createdBy",
    "hashAlgorithm",
    "contentHash",
    "references",
    "signature",
    "approval"
  ],
  "properties": {
    "schemaVersion": { "const": "agri.artifact/v1" },
    "artifactId": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": { "type": "string", "minLength": 1 },
    "hashAlgorithm": { "const": "sha256" },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "hash"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "recipe",
              "behavior-tree-ir",
              "module-manifest",
              "twin-spec",
              "map",
              "calibration-bundle",
              "model",
              "firmware",
              "configuration"
            ]
          },
          "id": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signerKeyId", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "signerKeyId": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "approvedBy", "approvedAt"],
      "properties": {
        "gate": { "type": "string", "pattern": "^G[0-9]{1,2}$" },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "changeTicket": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
