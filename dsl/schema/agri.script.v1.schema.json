{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agrirobots.local/schema/agri.script.v1.schema.json",
  "title": "AgriScript v1 task recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "agri.script/v1"},
    "kind": {"const": "Task"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "owner": {"type": "string", "minLength": 1},
        "changeTicket": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires", "limits", "preflight", "steps", "on_fault", "evidence"],
      "properties": {
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cassette", "operatorPolicy", "zones"],
          "properties": {
            "cassette": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "capability"],
              "properties": {"type": {"type": "string"}, "capability": {"type": "string"}}
            },
            "operatorPolicy": {"type": "string", "enum": ["supervisor_on_site", "two_person_rule", "remote_observer", "unattended_forbidden"]},
            "zones": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deadline_s"],
          "properties": {
            "travel_mps": {"type": "number", "exclusiveMinimum": 0, "maximum": 2.5},
            "deadline_s": {"type": "integer", "minimum": 1, "maximum": 28800},
            "max_retries": {"type": "integer", "minimum": 0, "maximum": 3}
          }
        },
        "preflight": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "on_fault": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["retain"],
          "properties": {"retain": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
        }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": true,
      "propertyNames": {
        "enum": ["navigate", "dock", "dispense_mass", "collect_egg", "apply_volume", "scan_row", "mechanical_weed", "record", "return_to", "safe_stop", "park_tool", "notify", "for_each", "when", "inspect"]
      }
    }
  }
}
